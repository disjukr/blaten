{
  "name": "blaten-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": { "node": ">=22.12.0", "pnpm": ">=10" },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --filter './packages/*' --if-present run test",
    "lint": "eslint packages/blaten/src packages/compiler/src packages/eslint-plugin/src packages/typegpu/src packages/typegpu/tests examples/mnist/src",
    "mnist": "pnpm --filter @blaten/mnist start"
  },
  "devDependencies": {
    "@blaten/eslint-plugin": "workspace:*",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "typescript": "~5.9.3",
    "@types/node": "^24.19.1",
    "@webgpu/types": "^0.1.64"
  }
}
