    "vite": "^8.0.0",
    "webgpu": "0.6.2"
  },
  "peerDependencies": { "typegpu": "~0.12.7", "webgpu": "0.6.2" },
  "peerDependenciesMeta": { "webgpu": { "optional": true } }
