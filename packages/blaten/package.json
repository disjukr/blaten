{
  "name": "blaten",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./trace": { "types": "./dist/trace.d.ts", "default": "./dist/trace.js" },
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./internal": { "types": "./dist/kernel.d.ts", "default": "./dist/kernel.js" },
    "./backend": { "types": "./dist/backend.d.ts", "default": "./dist/backend.js" },
    "./intrinsics": { "types": "./dist/intrinsics.d.ts", "default": "./dist/intrinsics.js" },
    "./ir": { "types": "./dist/kernel-ir.d.ts", "default": "./dist/kernel-ir.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node tests/dtypes.mjs && node tests/training.mjs && node --expose-gc tests/lifetime.mjs && node tests/trace.mjs"
  }
}
